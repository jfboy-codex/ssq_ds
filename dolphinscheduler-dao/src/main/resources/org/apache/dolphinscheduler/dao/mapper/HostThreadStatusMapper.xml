<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.dolphinscheduler.dao.mapper.HostThreadStatusMapper">
    <sql id="baseSql">
        id, host, thread_id, usable_time, usable_time_stamp
    </sql>
    <select id="queryAll" resultType="org.apache.dolphinscheduler.dao.entity.HostThreadStatus">
        select * from ssq_host_thread
    </select>
    <update id="update" parameterType="org.apache.dolphinscheduler.dao.entity.HostThreadStatus">
        update ssq_host_thread
        <set>
            <if test="host != null">host = #{host},</if>
            <if test="threadId != null">thread_id = #{threadId},</if>
            <if test="usableTime != null">usable_time = #{usableTime},</if>
            <if test="usableTimeStamp != null">usable_time_stamp = #{usableTimeStamp},</if>
        </set>
        where id = #{id}
    </update>
</mapper>
